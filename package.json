{
  "name": "@jiyr0119/dsh-service-console",
  "version": "0.5.0",
  "description": "DeepSeek Harness 本地开发服务控制台（原生插件）：发现监听端口，识别服务归属，安全查看/停止/重启。Local development service console for DSH.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jiyr0119/dsh-service-console.git"
  },
  "homepage": "https://github.com/Jiyr0119/dsh-service-console",
  "keywords": [
    "deepseek-harness",
    "cordis",
    "dsh-plugin",
    "local-dev-server",
    "port-manager"
  ],
  "files": [
    "lib",
    "dsh.plugin.json",
    "cordis.patch.yml",
    "dynamic",
    "docs",
    "assets",
    "demo",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "manifest.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "plugin": {
      "id": "dsh-service-console",
      "kind": "dynamic-cordis-plugin",
      "host": "dynamic/host.js",
      "client": "dynamic/client.js",
      "hostHandler": "scan",
      "clientSlots": [
        "conversation.session.header.utilities",
        "shell.overlay",
        "settings.section"
      ]
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.5-rc.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.1",
    "cordis": "^4.0.0-rc.7",
    "lightningcss": "^1.33.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "react": "^18.2.0"
  }
}
